__interrupt void TA0_A0_ISR(){

    TA0CCR1 += 20; // increase brightness
    if (TA0CCR1 >= 80){
        TA0CCR1 = 0; // roll back to zero
    } else if (TA0CCR1 == 20){
        TA0CCR1 -= 1; // reset to (20 - 1) from 0
    }

}

