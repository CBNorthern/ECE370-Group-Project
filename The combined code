int main(void)
{
    WDTCTL = WDTPW | WDTHOLD;   // stop watchdog timer
    PM5CTL0 &= ~LOCKLPM5; // Enable the GPIO pins

    Initialize_UART();
    Initialize_I2C();

    P1DIR |= redLED; // Direct pin as output (for red LED)
    P1OUT &= ~redLED; // Turn LED Off

    P9DIR |= greenLED; //Direct pin as output
    P9OUT &= ~greenLED; // Turn Green LED Off
     // Configure buttons
     P1DIR &= ~BUT1;       // Direct pin as input
     P1REN |= BUT1;           // Enable built-in resistor
     P1OUT |= BUT1;           // Set resistor as pull-up

     P1DIR &= ~BUT2;        // Direct pin as input
     P1REN |= BUT2;           // Enable built-in resistor
     P1OUT |= BUT2;           // Set resistor as pull-up

    // Configure ACLK to the 32 KHz crystal (function call)
    config_ACLK_to_32KHz_crystal();

    // Configure Timer 0 channel 0
     TA0CCR0 = 120 - 1; // set number of cycles for PWM

     // Configure Timer 0 Channel 1
     TA0CCR1 = 20 - 1; // start at lowest brightness level
     TA0CCTL1 |= OUTMOD_7; // Reset/Set Output Mode

     TA0CTL = TASSEL_1 | ID_0 | MC_1 | TACLR; // Crystal ACLK, Div = 0, Up Mode

     // Configure Timer 1 channel 0
     TA1CCR0 = 32768 - 1; // T = 1 second
     TA1CCTL0 &= ~CCIFG;
     TA1CCTL0 |= CCIE;

 // Configure Timer 1 channel 1
      TA1CCR1 = 65536 - 1;  // We need to do a counter so it will be 4 seconds
      TA1CCTL1 |= CCIE;
      TA1CCTL1 &= ~CCIFG; // Clear the flag

      TA1CTL = TASSEL_1 | ID_0 | MC_1 | TACLR; // Crystal ACLK, Div = 0, Up Mode

    _low_power_mode_3(); // Enable Low Power Mode 3

    //Configure the sensor
     i2c_write_word(0x44, 0x01, 0x7604);

    while(1){

    }
    return 0;
}
